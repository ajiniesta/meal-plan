# Supabase. Sin estas variables la app funciona en modo local sin cuentas.
# Con ellas, la app pide iniciar sesión con correo y contraseña.
# Crea un proyecto en https://supabase.com y copia los valores de Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
# Usa la clave anon clásica o la nueva publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
